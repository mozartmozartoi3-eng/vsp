{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "Voiture sans permis (VSP) en stock ou archivée dans le catalogue JEAN AUTO VSP.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 160 },
        "brand": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model": { "type": "string", "minLength": 1, "maxLength": 140 },
        "price": { "type": "number" },
        "year": { "type": "number" },
        "mileage": { "type": "number" },
        "energy": { "type": "string", "enum": ["Diesel", "Électrique", "Essence", "Hybride"] },
        "condition": { "type": "string", "enum": ["Occasion", "Neuf"] },
        "gearbox": { "type": "string", "maxLength": 80 },
        "power": { "type": "string", "maxLength": 80 },
        "color": { "type": "string", "maxLength": 80 },
        "availability": { "type": "string", "enum": ["available", "reserved", "sold"] },
        "status": { "type": "string", "enum": ["publish", "draft", "trash"] },
        "mainImage": { "type": "string", "maxLength": 500000 },
        "gallery": { "type": "array" },
        "features": { "type": "array" },
        "description": { "type": "string", "maxLength": 10000 },
        "warrantyMonths": { "type": "number" },
        "vin": { "type": "string", "maxLength": 64 },
        "seoTitle": { "type": "string", "maxLength": 200 },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "slug",
        "brand",
        "model",
        "price",
        "year",
        "mileage",
        "energy",
        "condition",
        "gearbox",
        "power",
        "color",
        "availability",
        "status",
        "mainImage",
        "gallery",
        "features",
        "description",
        "createdAt",
        "updatedAt"
      ]
    },
    "VehicleOrder": {
      "title": "VehicleOrder",
      "description": "Commande ou réservation d'un véhicule sans permis contenant les coordonnées client et détails de règlement.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 3, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "customer": { "type": "object" },
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vehicleName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "vehiclePrice": { "type": "number" },
        "vehicleImage": { "type": "string", "maxLength": 500000 },
        "paymentOption": { "type": "string", "enum": ["reservation", "comptant_50_50", "comptant_100", "plusieurs_fois", "installment", "full"] },
        "customInstallmentAmount": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "transmissionChannel": { "type": "string", "enum": ["whatsapp", "email"] },
        "cancellationGuaranteeDeadline": { "type": "string", "maxLength": 64 },
        "documentsDelivered": { "type": "boolean" },
        "paymentMethod": { "type": "string", "enum": ["card", "virement"] },
        "cardDetails": { "type": "object" },
        "amountPaid": { "type": "number" },
        "status": { "type": "string", "enum": ["nouvelle", "paiement_a_verifier", "paiement_confirme", "commande_confirmee", "documents_transmis", "reservation", "en_preparation", "vendu", "demande_annulation_72h", "remboursement_en_cours", "annulee", "refusee"] },
        "paymentProofUrl": { "type": "string", "maxLength": 2000 },
        "paymentProofFileName": { "type": "string", "maxLength": 255 },
        "paymentProofFileType": { "type": "string", "maxLength": 100 },
        "paymentProofSize": { "type": "string", "maxLength": 64 },
        "whatsappSent": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 2000 },
        "history": { "type": "array" },
        "cancellationRequestedAt": { "type": "string", "maxLength": 64 },
        "cancellationReason": { "type": "string", "maxLength": 1000 },
        "cancellationRefundStatus": { "type": "string", "enum": ["pending", "processed"] },
        "documentsDeliveredAt": { "type": "string", "maxLength": 64 },
        "documentsDeliveredChannel": { "type": "string", "enum": ["whatsapp", "email"] },
        "bankDetailsUsed": { "type": "object" }
      },
      "required": [
        "id",
        "orderNumber",
        "createdAt",
        "updatedAt",
        "customer",
        "vehicleId",
        "vehicleName",
        "vehiclePrice",
        "paymentOption",
        "amountPaid",
        "status",
        "history"
      ]
    },
    "VehicleBrand": {
      "title": "VehicleBrand",
      "description": "Marque constructeur de voitures sans permis.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "logoUrl": { "type": "string", "maxLength": 2000 },
        "count": { "type": "number" }
      },
      "required": ["id", "name", "slug", "count"]
    },
    "CustomerRecord": {
      "title": "CustomerRecord",
      "description": "Fiche client consolidée contenant des données personnelles (PII).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "firstName": { "type": "string", "maxLength": 100 },
        "lastName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "city": { "type": "string", "maxLength": 120 },
        "postalCode": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 300 },
        "ordersCount": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastOrderDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firstName", "lastName", "email", "phone", "city", "postalCode", "address", "ordersCount", "totalSpent", "lastOrderDate", "createdAt"]
    },
    "FaqItem": {
      "title": "FaqItem",
      "description": "Question fréquente affichée publiquement sur le site.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "answer": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" }
      },
      "required": ["id", "question", "answer", "category", "order"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Journal d'activité interne administrateur.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "maxLength": 200 },
        "entityType": { "type": "string", "enum": ["vehicle", "order", "brand", "setting", "payment", "user", "customer"] },
        "entityId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "format": "date-time" },
        "user": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "action", "entityType", "entityId", "details", "timestamp", "user"]
    },
    "CommercialBankSettings": {
      "title": "CommercialBankSettings",
      "description": "Coordonnées publiques de la concession et coordonnées bancaires de règlement.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "maxLength": 120 },
        "legalName": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 250 },
        "postalCode": { "type": "string", "maxLength": 20 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 80 },
        "landmark": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 160 },
        "accountHolder": { "type": "string", "maxLength": 120 },
        "iban": { "type": "string", "maxLength": 64 },
        "bic": { "type": "string", "maxLength": 32 },
        "rib": { "type": "string", "maxLength": 64 },
        "mandatoryReferenceInstruction": { "type": "string", "maxLength": 250 },
        "installmentDepositAmount": { "type": "number" },
        "openingHours": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "address", "postalCode", "city", "phone", "whatsapp", "email", "accountHolder", "iban", "bic", "rib", "installmentDepositAmount", "openingHours"]
    },
    "SeoSettings": {
      "title": "SeoSettings",
      "description": "Configuration SEO et métadonnées Schema.org du site.",
      "type": "object",
      "properties": {
        "metaTitle": { "type": "string", "maxLength": 200 },
        "metaDescription": { "type": "string", "maxLength": 500 },
        "canonicalUrl": { "type": "string", "maxLength": 500 },
        "ogImage": { "type": "string", "maxLength": 2000 },
        "allowRobotsIndex": { "type": "boolean" },
        "structuredDataEnabled": { "type": "boolean" },
        "sitemapGeneratedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["metaTitle", "metaDescription", "canonicalUrl", "ogImage", "allowRobotsIndex", "structuredDataEnabled"]
    },
    "WPPost": {
      "title": "WPPost",
      "description": "Article de blog WordPress.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 50000 },
        "excerpt": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["publish", "draft", "trash"] },
        "author": { "type": "string", "maxLength": 100 },
        "authorEmail": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "tags": { "type": "array" },
        "featuredImage": { "type": "string", "maxLength": 2000 },
        "commentCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "content", "status", "author", "category", "tags", "commentCount", "createdAt", "updatedAt"]
    },
    "WPPage": {
      "title": "WPPage",
      "description": "Page statique du site.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 50000 },
        "status": { "type": "string", "enum": ["publish", "draft", "trash"] },
        "author": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" },
        "parent": { "type": "string", "maxLength": 128 },
        "template": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "content", "status", "author", "order", "createdAt", "updatedAt"]
    },
    "WPMedia": {
      "title": "WPMedia",
      "description": "Fichier média de la bibliothèque.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 2000 },
        "fileName": { "type": "string", "maxLength": 255 },
        "fileType": { "type": "string", "maxLength": 100 },
        "sizeFormatted": { "type": "string", "maxLength": 64 },
        "dimensions": { "type": "string", "maxLength": 64 },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "altText": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "title", "url", "fileName", "fileType", "sizeFormatted", "uploadedAt"]
    },
    "WPCategory": {
      "title": "WPCategory",
      "description": "Catégorie d'articles.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "count": { "type": "number" }
      },
      "required": ["id", "name", "slug", "count"]
    },
    "WPComment": {
      "title": "WPComment",
      "description": "Commentaire client ou visiteur.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postTitle": { "type": "string", "maxLength": 300 },
        "authorName": { "type": "string", "maxLength": 120 },
        "authorEmail": { "type": "string", "maxLength": 200 },
        "authorAvatar": { "type": "string", "maxLength": 2000 },
        "content": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["approved", "pending", "trash"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "postTitle", "authorName", "authorEmail", "content", "status", "createdAt"]
    },
    "WPUser": {
      "title": "WPUser",
      "description": "Compte utilisateur du backoffice (données sensibles email).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["administrator", "editor", "author", "subscriber"] },
        "postCount": { "type": "number" },
        "registeredAt": { "type": "string", "maxLength": 64 },
        "avatar": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "username", "name", "email", "role", "postCount", "registeredAt"]
    },
    "WPSiteSettings": {
      "title": "WPSiteSettings",
      "description": "Paramètres généraux du site.",
      "type": "object",
      "properties": {
        "siteTitle": { "type": "string", "maxLength": 200 },
        "tagline": { "type": "string", "maxLength": 300 },
        "siteUrl": { "type": "string", "maxLength": 500 },
        "adminEmail": { "type": "string", "maxLength": 200 },
        "defaultCategory": { "type": "string", "maxLength": 100 },
        "postsPerPage": { "type": "number" },
        "commentsOpen": { "type": "boolean" },
        "timezone": { "type": "string", "maxLength": 80 },
        "dateFormat": { "type": "string", "maxLength": 40 }
      },
      "required": ["siteTitle", "tagline", "siteUrl", "adminEmail", "defaultCategory", "postsPerPage", "commentsOpen", "timezone", "dateFormat"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Liste blanche des administrateurs vérifiés par UID.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin"] },
        "label": { "type": "string", "maxLength": 120 },
        "addedBy": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },

    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Document de test de connectivité serveur Firestore.",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 64 }
      },
      "required": ["status"]
    }
  },
  "firestore": {
    "/vsp_vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Parc de véhicules sans permis (public en lecture si status == 'publish', gestion complète admin)."
    },
    "/vsp_orders/{orderId}": {
      "schema": { "$ref": "#/entities/VehicleOrder" },
      "description": "Commandes et réservations clients (lecture/modification strictement réservée aux administrateurs; création client validée)."
    },
    "/vsp_brands/{brandId}": {
      "schema": { "$ref": "#/entities/VehicleBrand" },
      "description": "Marques de véhicules sans permis."
    },
    "/vsp_customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerRecord" },
      "description": "Fiches clients PII réservées exclusivement aux administrateurs."
    },
    "/vsp_faqs/{faqId}": {
      "schema": { "$ref": "#/entities/FaqItem" },
      "description": "Questions fréquentes de la concession."
    },
    "/vsp_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Journal des actions administratives."
    },
    "/vsp_commercial_settings/{settingId}": {
      "schema": { "$ref": "#/entities/CommercialBankSettings" },
      "description": "Coordonnées de la concession et informations bancaires publiques de règlement."
    },
    "/vsp_seo/{seoId}": {
      "schema": { "$ref": "#/entities/SeoSettings" },
      "description": "Paramètres SEO de la concession."
    },
    "/wp_posts/{postId}": {
      "schema": { "$ref": "#/entities/WPPost" },
      "description": "Articles de blog."
    },
    "/wp_pages/{pageId}": {
      "schema": { "$ref": "#/entities/WPPage" },
      "description": "Pages du site."
    },
    "/wp_media/{mediaId}": {
      "schema": { "$ref": "#/entities/WPMedia" },
      "description": "Médiathèque."
    },
    "/wp_categories/{categoryId}": {
      "schema": { "$ref": "#/entities/WPCategory" },
      "description": "Catégories d'articles."
    },
    "/wp_comments/{commentId}": {
      "schema": { "$ref": "#/entities/WPComment" },
      "description": "Commentaires."
    },
    "/wp_users/{userId}": {
      "schema": { "$ref": "#/entities/WPUser" },
      "description": "Utilisateurs backoffice (PII restreinte aux administrateurs)."
    },
    "/wp_settings/{settingId}": {
      "schema": { "$ref": "#/entities/WPSiteSettings" },
      "description": "Paramètres généraux du site."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Registre des UIDs administrateurs autorisés."
    },

    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionTest" },
      "description": "Test de connexion Firestore au démarrage."
    }
  }
}
